{
  "name": "ghostedit",
  "version": "1.9.0",
  "description": "Cross-platform AI text correction from the menu bar",
  "author": "GhostEdit contributors",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint src/",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "download-model": "node scripts/download-model.mjs",
    "make:deb": "electron-forge make --platform linux --arch x64",
    "make:deb:arm64": "electron-forge make --platform linux --arch arm64",
    "make:win": "electron-forge make --platform win32 --arch x64",
    "make:win:arm64": "electron-forge make --platform win32 --arch arm64",
    "make:mac:arm64": "electron-forge make --platform darwin --arch arm64",
    "make:mac:x64": "electron-forge make --platform darwin --arch x64"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "jsdom": "^29.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "dictionary-en": "^4.0.0",
    "diff-match-patch": "^1.0.5",
    "electron-updater": "^6.8.3",
    "harper.js": "^1.9.0",
    "nspell": "^2.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uiohook-napi": "^1.5.4",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "onnxruntime-node@1.21.0": true,
    "sharp@0.34.5": true,
    "uiohook-napi@1.5.4": true,
    "electron-winstaller@5.4.0": true,
    "protobufjs@7.6.6": true
  }
}
